        "id": 1003571
      },
      "writtenOn": "2025-06-13T23:56:13Z",
      "side": 1,
      "message": "This is not safe without some kind of locking or use of atomics. Activity on an export is not suspended during export update.",
      "revId": "110655858a554265dcda4558a55508a4c6297bd8",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
    },
