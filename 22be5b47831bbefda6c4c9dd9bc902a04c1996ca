      "key": {
        "uuid": "20421814_59b10f50",
        "filename": "src/Protocols/NLM/nsm.c",
        "patchSetId": 10
      },
      "lineNbr": 853,
      "author": {
        "id": 1003571
      },
      "writtenOn": "2026-07-21T18:22:47Z",
      "side": 1,
      "message": "Oh, yea, quite a mess... Glad you caught that.\n\nSee note above about having component in local_nlm_info",
      "parentUuid": "0e00deb6_9d04dea7",
      "revId": "22be5b47831bbefda6c4c9dd9bc902a04c1996ca",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
