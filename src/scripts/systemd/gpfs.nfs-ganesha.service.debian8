# Storage Scale (GPFS) systemd unit for Debian/Ubuntu distributions.
#
# Runs /usr/bin/gpfs.ganesha.nfsd using the unified /run/sysconfig/ganesha
# runtime environment and delegates lock recovery to Storage Scale.

[Unit]
Description=NFS-Ganesha file server
Documentation=http://github.com/nfs-ganesha/nfs-ganesha/wiki

# Omit nfs-ganesha-lock.service; GPFS/Scale manages lock recovery externally
After=rpcbind.service nfs-ganesha-config.service
Wants=rpcbind.service nfs-ganesha-config.service
Conflicts=nfs.target


[Service]
Type=forking
RuntimeDirectory=ganesha

# Read unified runtime environment generated by gpfs.nfs-ganesha-config.sh
EnvironmentFile=-/run/sysconfig/ganesha

# Launch GPFS daemon binary with optional env overrides and NUMA policy
ExecStart=/bin/bash -c "${ENV_OPTIONS} ${NUMACTL} ${NUMAOPTS} /usr/bin/gpfs.ganesha.nfsd -C ${OPTIONS} ${EPOCH} ${GNODEID}"
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/usr/bin/dbus-send --system --dest=org.ganesha.nfsd --type=method_call /org/ganesha/nfsd/admin org.ganesha.nfsd.admin.shutdown

# Cap stop wait time at 15s to prevent cluster failover delays
TimeoutStopSec=15

