#
# GPFS SCALE systemd unit for RHEL/RPM distributions.
#
# There can only be one NFS server active on a system. When NFS-Ganesha is
# started, the kernel NFS server should be stopped; this is enforced via the
# 'Conflicts=nfs.target' directive in this unit.
#
# Unlike standard upstream deployments, this unit runs /usr/bin/gpfs.ganesha.nfsd
# and omits nfs-ganesha-lock.service (rpc.statd)
# as well as log and state directory management to GPFS SCALE.

[Unit]
Description=NFS-Ganesha file server
Documentation=http://github.com/nfs-ganesha/nfs-ganesha/wiki

# Omit nfs-ganesha-lock.service; GPFS SCALE manages lock recovery externally
After=rpcbind.service nfs-ganesha-config.service
Wants=rpcbind.service nfs-ganesha-config.service
Conflicts=nfs.target


[Service]
Type=forking

# Manage /run/ganesha via systemd; GPFS SCALE manages /var/log/ganesha and /var/lib/nfs/ganesha
RuntimeDirectory=ganesha
# LogsDirectory=ganesha
# StateDirectory=nfs/ganesha

# Load runtime options generated by nfs-ganesha-config.service
EnvironmentFile=-/run/sysconfig/ganesha

# Launch GPFS daemon binary with optional env, NUMA, and cluster node overrides
ExecStart=/bin/bash -c "${ENV_OPTIONS} ${MALLOC_ARENA_MAX} ${NUMACTL} ${NUMAOPTS} /usr/bin/gpfs.ganesha.nfsd -C ${OPTIONS} ${EPOCH} ${GNODEID}"
ExecReload=/bin/kill -HUP $MAINPID

# Request graceful daemon shutdown over D-Bus
ExecStop=/bin/dbus-send --system --dest=org.ganesha.nfsd --type=method_call /org/ganesha/nfsd/admin org.ganesha.nfsd.admin.shutdown

# Cap stop wait time at 15s to prevent cluster failover delays
TimeoutStopSec=15


[Install]
WantedBy=multi-user.target

