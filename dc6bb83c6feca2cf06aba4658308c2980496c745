      "key": {
        "uuid": "02940bea_69a55c6a",
        "filename": "src/FSAL/FSAL_VFS/namedattr.c",
        "patchSetId": 2
      },
      "lineNbr": 208,
      "author": {
        "id": 1040080
      },
      "writtenOn": "2026-10-23T23:01:47Z",
      "side": 1,
      "message": "namedattr.c is now Linux only, with stubs for other platforms under #else,\nwhere OPENATTR returns NFS4ERR_NOTSUPP. The stubs also cover\nvfs_is_attr_handle(), which only the Linux handle code defined, so FreeBSD\nwould otherwise not have linked. I can\u0027t build on FreeBSD here, so I checked\nthe stubs by compiling namedattr.c with LINUX undefined.",
      "parentUuid": "ff98b75e_ab6771cc",
      "revId": "dc6bb83c6feca2cf06aba4658308c2980496c745",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "3e42b5e2_88d58eea",
        "filename": "src/FSAL/FSAL_VFS/namedattr.c",
