        "patchSetId": 7
      },
      "lineNbr": 49,
      "author": {
        "id": 1020258
      },
      "writtenOn": "2026-04-21T13:05:16Z",
      "side": 1,
      "message": "start can be called even if the server was already started, and it will spawn a new thread and re-assign a value to the `server_thread_` variable",
      "range": {
        "startLine": 43,
        "startChar": 0,
        "endLine": 49,
        "endChar": 5
      },
      "revId": "d80a6858ef95232ac4b0a45a755aae3a5e67bbf1",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
